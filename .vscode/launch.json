    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SoFixer32",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build SoFixer32",
            "program": "${workspaceFolder}/build/SoFixer32.exe",
            "args": ["-s", "errorlog_0x7c9710a000_0x4b000.so", "-o", "fix.so", "-m", "0x7c9710a000", "-d"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],

            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug SoFixer64",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build SoFixer64",
            "program": "${workspaceFolder}/build/SoFixer64.exe",
            "args": ["-s", "errorlog_0x7c9710a000_0x4b000.so", "-o", "fix.so", "-m", "0x7c9710a000", "-d"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}